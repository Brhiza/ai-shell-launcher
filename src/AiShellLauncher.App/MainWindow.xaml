<Window x:Class="AiShellLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Shell Launcher"
        Icon="Assets/Logo.ico"
        Width="820"
        Height="620"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="4,0,4,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="右键菜单" FontSize="25" FontWeight="SemiBold" Foreground="#172033" />
      <Button x:Name="TerminalButton"
              Grid.Column="1"
              Click="Terminal_Click"
              VerticalAlignment="Center" />
      <Button Grid.Column="2"
              Content="＋ 添加"
              Click="AddTool_Click"
              Style="{StaticResource PrimaryButtonStyle}"
              VerticalAlignment="Center" />
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
      <ListBox ItemsSource="{Binding Tools}"
               BorderThickness="0"
               Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Padding="14,12" CornerRadius="8" Background="White">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="9" Background="#EEF4FF" VerticalAlignment="Center">
                  <Image Source="{Binding DisplayIconPath}" Width="22" Height="22" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#172033" />
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="{Binding MenuSummary}" Foreground="#667085" FontSize="12" />
                    <TextBlock Text=" · " Foreground="#98A2B3" FontSize="12" />
                    <TextBlock Text="{Binding Status}" Foreground="#667085" FontSize="12" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                  <Button Content="设置" Click="EditTool_Click" Tag="{Binding}" Margin="0" />
                  <Button Content="删除"
                          Click="DeleteTool_Click"
                          Tag="{Binding}"
                          Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Margin="8,0,0,0" />
                </StackPanel>
                <CheckBox Grid.Column="3"
                          Content="启用"
                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="4,0,8,0" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Grid.Row="2" Margin="4,16,4,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="1" Content="保存并应用" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" />
    </Grid>
  </Grid>
</Window>
