<Window x:Class="AiShellLauncher.App.ToolEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiShellLauncher.App"
        Title="命令设置"
        Icon="Assets/Logo.ico"
        Width="720"
        Height="680"
        MinWidth="620"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="2,0,2,16">
      <TextBlock Text="命令设置" FontSize="24" FontWeight="SemiBold" Foreground="#172033" />
      <TextBlock Text="设置程序，以及右键菜单显示的文字和图标" Margin="0,4,0,0" Foreground="#667085" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="2,0,10,0">
        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="命令名称" FontWeight="SemiBold" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="启动程序" FontWeight="SemiBold" />
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
              <Button Grid.Column="1" Content="选择…" Click="BrowseCommand_Click" Margin="8,0,0,0" />
              <Button Grid.Column="2" Content="检测" Click="Detect_Click" Margin="8,0,0,0" />
            </Grid>
            <TextBlock Text="{Binding Status}" Foreground="#667085" FontSize="12" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <Grid Margin="2,0,2,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="右键菜单" FontSize="17" FontWeight="SemiBold" Foreground="#172033" />
            <TextBlock Text="打开要显示的项目；每项都会直接出现在首层菜单" Foreground="#667085" FontSize="12" Margin="0,3,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Content="＋ 自定义菜单项" Click="AddMode_Click" VerticalAlignment="Center" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Modes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,10">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding Enabled}"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Background="#FFF4E5"
                            CornerRadius="5"
                            Padding="7,3"
                            Margin="8,0"
                            Visibility="{Binding IsYolo, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBlock Text="高风险" Foreground="#B54708" FontSize="11" />
                    </Border>
                    <Button Grid.Column="2" Content="移除" Click="DeleteMode_Click" Tag="{Binding}" Padding="10,5" Margin="0" />
                  </Grid>

                  <TextBlock Text="菜单文字" FontSize="12" Foreground="#475467" Margin="0,12,0,0" />
                  <TextBox Text="{Binding MenuTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />

                  <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="图标" Foreground="#475467" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding IconDisplay}"
                               Foreground="#667085"
                               Margin="10,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Content="选择…" Click="BrowseIcon_Click" Tag="{Binding}" Padding="10,5" Margin="0" />
                    <Button Grid.Column="3" Content="使用默认" Click="ClearIcon_Click" Tag="{Binding}" Padding="10,5" Margin="8,0,0,0" />
                  </Grid>

                  <Expander Header="高级设置" Margin="0,12,0,0" Foreground="#475467">
                    <StackPanel Margin="0,9,0,0">
                      <TextBlock Text="运行方式" FontSize="12" Foreground="#475467" />
                      <ComboBox ItemsSource="{x:Static local:ModeEditorViewModel.RiskChoices}"
                                DisplayMemberPath="Label"
                                SelectedValuePath="Value"
                                SelectedValue="{Binding Risk, Mode=TwoWay}"
                                Padding="7,5"
                                Margin="0,4,0,10" />
                      <TextBlock Text="启动参数" FontSize="12" Foreground="#475467" />
                      <TextBox Text="{Binding ArgumentsText, UpdateSourceTrigger=PropertyChanged}"
                               AcceptsReturn="True"
                               MinHeight="58"
                               Margin="0,4,0,0" />
                      <TextBlock Text="可使用 {path} 代表当前文件夹。" Foreground="#667085" FontSize="11" Margin="0,5,0,0" />
                    </StackPanel>
                  </Expander>

                  <TextBlock Text="YOLO 会跳过安全确认，请只在可信、可恢复的目录使用。"
                             Foreground="#B54708"
                             FontSize="11"
                             Margin="0,10,0,0"
                             Visibility="{Binding IsYolo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,2,0">
      <Button Content="取消" Click="Cancel_Click" />
      <Button Content="完成" Click="Confirm_Click" Style="{StaticResource PrimaryButtonStyle}" />
    </StackPanel>
  </Grid>
</Window>
