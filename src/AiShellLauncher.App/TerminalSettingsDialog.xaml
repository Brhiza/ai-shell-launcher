<Window x:Class="AiShellLauncher.App.TerminalSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiShellLauncher.App"
        Title="终端设置"
        Icon="Assets/Logo.ico"
        Width="560"
        SizeToContent="Height"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="2,0,2,16">
      <TextBlock Text="终端设置" FontSize="24" FontWeight="SemiBold" Foreground="#172033" />
      <TextBlock Text="选择右键命令在哪个终端中打开" Margin="0,4,0,0" Foreground="#667085" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18">
      <StackPanel>
        <TextBlock Text="打开方式" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{x:Static local:TerminalEditorViewModel.Choices}"
                  DisplayMemberPath="Label"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding Kind, Mode=TwoWay}"
                  Padding="8,6"
                  Margin="0,5,0,0" />
        <TextBlock Text="{Binding Description}" Foreground="#667085" FontSize="12" Margin="0,7,0,0" />

        <Border Margin="0,16,0,0"
                Padding="14"
                Background="#F8FAFC"
                CornerRadius="8"
                Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="终端程序" FontWeight="SemiBold" />
            <Grid Margin="0,4,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
              <Button Grid.Column="1" Content="选择…" Click="Browse_Click" Margin="8,0,0,0" />
              <Button Grid.Column="2" Content="检测" Click="Detect_Click" Margin="8,0,0,0" />
            </Grid>
            <TextBlock Text="{Binding Status}" Foreground="#667085" FontSize="12" Margin="0,0,0,10" />
            <TextBlock Text="启动参数" FontWeight="SemiBold" />
            <TextBox Text="{Binding ArgumentsText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     MinHeight="62"
                     Margin="0,4,0,0" />
            <TextBlock Text="必须保留 {command} 和 {args}；可用 {path} 代表当前文件夹。"
                       Foreground="#667085"
                       FontSize="11"
                       Margin="0,5,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,2,0">
      <Button Content="取消" Click="Cancel_Click" />
      <Button Content="完成" Click="Confirm_Click" Style="{StaticResource PrimaryButtonStyle}" />
    </StackPanel>
  </Grid>
</Window>
